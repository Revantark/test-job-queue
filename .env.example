DATABASE_URL=postgres://rev@localhost:5432/hunar_jobs
# Queue consumed by `run` (default: default)
SCHEDULER_QUEUE=default
# Concurrent jobs per worker process
SCHEDULER_POOL_SIZE=4
# Lease duration in seconds (heartbeat renews at lease/3)
SCHEDULER_LEASE_SECS=30
# Max running jobs per organization within a single claim round
SCHEDULER_PER_ORG_LIMIT=2
# Log level (RUST_LOG-style)
RUST_LOG=info
